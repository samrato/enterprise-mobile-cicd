# ==============================================================================
# .env.example — Secrets & Environment Variables Reference
#
# DO NOT store actual secret values in this file!
# Copy these key names into GitHub Repository Secrets (or GitHub Environment Secrets)
# and set their actual values in the GitHub Web Console:
# Settings -> Secrets and variables -> Actions
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Android Code Signing & Keystore Secrets
# Required for signing APK / AAB artifacts during CI/CD builds
# ------------------------------------------------------------------------------
# Base64 encoded contents of your release.keystore / release.jks file:
#   Generate with: base64 -w 0 path/to/release.keystore
ANDROID_KEYSTORE_BASE64=

# Passwords for the keystore and alias key:
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Android Application ID / Package Name (can also be set as a Repository Variable):
ANDROID_APPLICATION_ID=com.company.app

# ------------------------------------------------------------------------------
# 2. Google Play Console Deployment
# Required for publishing to Google Play Store tracks (internal, beta, production)
# ------------------------------------------------------------------------------
# Full JSON contents of your Google Play Service Account key with Release Manager permissions:
PLAY_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'

# ------------------------------------------------------------------------------
# 3. iOS / App Store Connect (Fastlane) Setup
# Required when ios.enabled is true
# ------------------------------------------------------------------------------
APP_STORE_CONNECT_API_KEY_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_KEY=
FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=
MATCH_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Feature Flags & Remote Configuration
# Required when featureFlags.provider is set
# ------------------------------------------------------------------------------
# Firebase Service Account JSON (for Firebase Remote Config):
FIREBASE_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'

# LaunchDarkly SDK Key (for LaunchDarkly integration):
LAUNCHDARKLY_SDK_KEY=

# ------------------------------------------------------------------------------
# 5. Visual Regression Testing Credentials
# Required when testing.visual_regression.enabled is true
# ------------------------------------------------------------------------------
CHROMATIC_PROJECT_TOKEN=
PERCY_TOKEN=

# ------------------------------------------------------------------------------
# 6. Pipeline Notifications
# Required when notifications.slack or notifications.email is enabled
# ------------------------------------------------------------------------------
# Slack Incoming Webhook URL:
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Email SMTP Credentials (for python notify-email.py):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ci-notifications@company.com
SMTP_PASS=app-specific-password

# ------------------------------------------------------------------------------
# 7. GitHub Tokens & Release Permissions (Optional)
# ------------------------------------------------------------------------------
# Personal Access Token with repo write scope (if default GITHUB_TOKEN is insufficient):
GH_PAT_TOKEN=
